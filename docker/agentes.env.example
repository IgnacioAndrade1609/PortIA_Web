REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
IDEMPOTENCY_TTL=86400
IDEMPOTENCY_LOCK_TTL=900
NATIVE_TEXT_THRESHOLD=100
CONFIDENCE_THRESHOLD=0.7
HF_HOME=/app/.cache/huggingface
OCR_ENGINE=easyocr
OCR_LANG=es,en
MAX_FILE_MB=50
MAX_PAGES=50
DOCUMENT_TIMEOUT=120
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_MODEL_FALLBACK=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
LLM_RESPONSE_FORMAT=auto
LLM_REASONING=false
LLM_PROVIDER_ONLY=
LLM_ALLOW_FALLBACKS=false
